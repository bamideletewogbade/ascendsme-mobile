{
  "permissions": {
    "allow": [
      "Bash(flutter pub *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/auto-doc-reminder.ps1"
          }
        ]
      }
    ]
  }
}
